@"
# Arquivos executáveis pesados do Ollama
ollama
ollama.exe

# Pasta de modelos da IA (~2 GB)
modelos/
modelos/*

# Ambiente Python portátil e bibliotecas instaladas
python/
lib/
__pycache__/

# Documentos locais e extensões descompactadas
Doc/
extensoes/

# Arquivos temporários e logs do Windows/Linux
*.log
*.tmp
.DS_Store
"@ | Set-Content -Path ".gitignore" -Encoding UTF8

git status
